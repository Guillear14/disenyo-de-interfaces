<Window x:Class="Examen_DI_19_11_2025.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Examen DI 19/11/2025"
        Height="720"
        Width="1200"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#F4F7FF" CornerRadius="20" BorderBrush="#D7DDF3" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1F2544" CornerRadius="20,20,0,0">
                <Grid>
                    <TextBlock Text="GESTIÓN EMPRESARIAL" VerticalAlignment="Center"
                               Margin="25,0,0,0" FontSize="24" FontWeight="Bold" Foreground="White" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,18,0">
                        <Button x:Name="btnMinimizar" Width="34" Height="34" Margin="5,0" 
                                Background="#6266F7" BorderThickness="0" Foreground="White"
                                Click="BtnMinimizar_Click">—</Button>
                        <Button x:Name="btnMaximizar" Width="34" Height="34" Margin="5,0"
                                Background="#05D79E" BorderThickness="0" Foreground="White"
                                Click="BtnMaximizar_Click">▢</Button>
                        <Button x:Name="btnCerrar" Width="34" Height="34" Margin="5,0"
                                Background="#FF5A82" BorderThickness="0" Foreground="White"
                                Click="BtnCerrar_Click">✕</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#EEF3FF" BorderBrush="#D3DAF2" BorderThickness="0,0,1,0">
                    <StackPanel Margin="20,25,18,20">
                        <Button Content="Inicio" Height="42" Margin="0,0,0,12" Background="#6266F7" Foreground="White" BorderThickness="0" />
                        <Button Content="Empleados" Height="42" Margin="0,0,0,12" Background="#05D79E" Foreground="White" BorderThickness="0" />
                        <Button Content="Departamentos" Height="42" Margin="0,0,0,12" Background="#807FFF" Foreground="White" BorderThickness="0" />
                        <Button Content="Productos" Height="42" Margin="0,0,0,12" Background="#FF5A82" Foreground="White" BorderThickness="0" />
                        <Button Content="Reportes" Height="42" Margin="0,0,0,30" Background="#2D3358" Foreground="White" BorderThickness="0" />

                        <Button x:Name="btnNuevoEmpleado" Content="Nuevo empleado" Height="48" FontWeight="Bold"
                                Background="#3A5BFF" Foreground="White" BorderThickness="0" Click="BtnNuevoEmpleado_Click" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="24" Margin="0,0,0,20" BorderBrush="#DDE4FF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Panel principal" FontSize="18" FontWeight="Bold" Foreground="#1F2544" />
                            <TextBlock Text="Se trata de la parte central de la aplicación. Aquí se gestionan los empleados y los datos de negocio." Margin="0,8,0,0" Foreground="#4B5678" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#EAF8F3" CornerRadius="16" Margin="0,0,12,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Personal" Foreground="#0B5E4B" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="128" FontSize="30" FontWeight="Bold" Foreground="#0B5E4B" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#EEF1FF" CornerRadius="16" Margin="12,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Activos" Foreground="#3C4BAA" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="96" FontSize="30" FontWeight="Bold" Foreground="#3C4BAA" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFF0F4" CornerRadius="16" Margin="12,0,0,0" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Bajas" Foreground="#C44367" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="14" FontSize="30" FontWeight="Bold" Foreground="#C44367" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="16" BorderBrush="#DDE4FF" BorderThickness="1" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Últimos empleados" FontSize="20" FontWeight="Bold" Foreground="#1F2544" Margin="0,0,0,18" />

                            <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent">
                                <ListBoxItem>María López - Recursos Humanos</ListBoxItem>
                                <ListBoxItem>Pedro García - Ventas</ListBoxItem>
                                <ListBoxItem>Ana Martínez - Administración</ListBoxItem>
                                <ListBoxItem>José Ruiz - Producción</ListBoxItem>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
