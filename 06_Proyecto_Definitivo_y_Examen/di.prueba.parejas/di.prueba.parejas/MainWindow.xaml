<Window x:Class="di.prueba.parejas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:di.prueba.parejas"
        mc:Ignorable="d" Background="Transparent" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" 
        Title="MainWindow" Height="750" Width="1300">
    <Border CornerRadius="10" BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#6D2FFF" Offset="0" />
                <GradientStop Color="#FB539B" Offset="0.5" />
                <GradientStop Color="#836EFB" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0" >
                <GradientStop Color="#060531" Offset="0" />
                <GradientStop Color="#1B1448" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <DockPanel>
            <Border DockPanel.Dock="Left" Width="250" CornerRadius="10,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="#29105F" Offset="1" />
                        <GradientStop Color="#210F55" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <!-- Parte Izquierda -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,20,0,0">
                        <Image Source="/Iconos/matisse.png" Height="30" Width="30" VerticalAlignment="Center" />
                        <TextBlock Text="DESARROLLO DE INTERFACES" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Background="Transparent" BorderBrush="Transparent" Margin="20,30,0,0" Width="100" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Width="99">
                            <Image Source="/Iconos/inicio.png" Width="20" Height="20" HorizontalAlignment="Left"/>
                            <TextBlock Text="Inicio" FontSize="10" Foreground="White" Margin="20,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent" BorderBrush="Transparent" Margin="20,30,0,0" Width="100" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Width="99">
                            <Image Source="/Iconos/grupo.png" Width="20" Height="20" HorizontalAlignment="Left"/>
                            <TextBlock Text="Clientes" FontSize="10" Foreground="White" Margin="20,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent" BorderBrush="Transparent" Margin="20,30,0,0" Width="100" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Width="95">
                            <Image Source="/Iconos/reparto.png" Width="20" Height="20" HorizontalAlignment="Left"/>
                            <TextBlock Text="Pedido" FontSize="10" Foreground="White" Margin="20,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent" BorderBrush="Transparent" Margin="20,30,0,0" Width="100" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Iconos/bolsa.png" Width="20" Height="20" HorizontalAlignment="Left"/>
                            <TextBlock Text="Transacción" FontSize="10" Foreground="White" Margin="20,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent" BorderBrush="Transparent" Margin="20,30,0,0" Width="100" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Width="90">
                            <Image Source="/Iconos/stock.png" Width="20" Height="20" HorizontalAlignment="Left"/>
                            <TextBlock Text="Stock" FontSize="10" Foreground="White" Margin="20,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent" BorderBrush="Transparent" Margin="20,30,0,0" Width="100" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Width="89">
                            <Image Source="/Iconos/ventas.png" Width="20" Height="20"/>
                            <TextBlock Text="Ventas" FontSize="10" Foreground="White" Margin="20,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent" BorderBrush="Transparent" Margin="20,30,0,0" Width="100" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Iconos/chart.png" Width="20" Height="20" HorizontalAlignment="Left"/>
                            <TextBlock Text="Informes" FontSize="10" Foreground="White" Margin="20,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Background="Transparent" BorderBrush="Transparent" Margin="20,30,0,0" Width="120" Focusable="False" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Iconos/configuracion.png" Width="20" Height="20" HorizontalAlignment="Left"/>
                            <TextBlock Text="Configuracion" FontSize="10" Foreground="White" Margin="20,10,0,0" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border CornerRadius="10,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="#0A003A" Offset="1" />
                        <GradientStop Color="#1C0C49" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,5,0" FlowDirection="RightToLeft" Background="Transparent">
                        <Button Background="Transparent" BorderBrush="Transparent" x:Name="btnCerrar" Click="btnCerrar_Click">
                            <Image Source="/Iconos/x.png" Margin="2" />
                        </Button>
                        <Button Background="Transparent" BorderBrush="Transparent" Margin="10,0,0,0" >
                            <Image Source="/Iconos/max.png" Margin="4" />
                        </Button>
                        <Button Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Bottom"
                                Margin="10,0,0,2" Height="20" >
                            <Image Source="/Iconos/min.png"  />
                        </Button>
                    </StackPanel>
                    <!-- Parte Superior -->
                    <Grid Grid.Row="1">
                        <Image Source="/Iconos/homeblanco.png" Width="30" Height="30" HorizontalAlignment="Left" Margin="20,0,0,0" />
                        <TextBlock Text="INICIO" Foreground="White" Margin="60,10,0,0" FontWeight="Bold" FontSize="15"/>
                        <Image Source="/Iconos/bell.png" Width="30" Height="30" Margin="100,0,0,0" />
                        <Image Source="/Iconos/carta.png" Width="30" Height="30" Margin="170,0,0,0" />
                        <Image Source="/Iconos/clock.png" Width="30" Height="30" Margin="250,0,0,0" />
                        <Image Source="/Iconos/user.png"  Width="30" Height="30" Margin="330,0,0,0" />
                        <TextBlock Text="Usuario no ha iniciado sesión" Foreground="White" Margin="710,10,0,0" FontWeight="Bold" FontSize="15"/>
                        <Image Source="/Iconos/down.png" Width="20" Height="20" Margin="830,0,0,0" />
                    </Grid>
                    <!-- Parte Central -->
                    <ContentControl Grid.Row="2" Margin="20" Background="#29105F">
                        <Grid>
                            <Border Width="220" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="10" >
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0" >
                                        <GradientStop Color="#785CFF" Offset="0" />
                                        <GradientStop Color="#76A1FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="/Iconos/grupoblanco.png" Width="50" Height="70" HorizontalAlignment="Left" Margin="10,0,0,0" />
                                    <TextBlock Text="480" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                                    <Image Source="/Iconos/linegraph.png" Width="50" Height="50" HorizontalAlignment="Right" Margin="0,20,20,0" />
                                </Grid>
                            </Border>
                            <Border Width="220" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="10" Margin="240,0,0,0" >
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0" >
                                        <GradientStop Color="#76A5FF" Offset="0" />
                                        <GradientStop Color="#40CDF4" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="/Iconos/camion.png" Width="50" Height="70" HorizontalAlignment="Left" Margin="10,0,0,0" />
                                    <TextBlock Text="720" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                                    <Image Source="/Iconos/grafico.png" Width="50" Height="50" HorizontalAlignment="Right" Margin="0,20,20,0" />
                                </Grid>
                            </Border>
                            <Border Width="220" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="10" Margin="480,0,0,0" >
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0" >
                                        <GradientStop Color="#FF689C" Offset="0" />
                                        <GradientStop Color="#FFAAAC" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="/Iconos/bag.png" Width="50" Height="70" HorizontalAlignment="Left" Margin="10,0,0,0" />
                                    <TextBlock Text="640" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                                    <Image Source="/Iconos/choice.png" Width="50" Height="50" HorizontalAlignment="Right" Margin="0,20,20,0" />
                                </Grid>
                            </Border>
                            <Border Width="250" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="10" Margin="720,0,0,0" >
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" >
                                        <GradientStop Color="#FFA8AD" Offset="0" />
                                        <GradientStop Color="#7DA3FD" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="/Iconos/discos.png" Width="40" Height="40" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" />
                                    <TextBlock Text="Tu Saldo" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,50,30,0" />
                                    <TextBlock Text="1.230 €" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,60,0,0" />
                                    <Image Source="/Iconos/chart96.png" Width="70" Height="70" HorizontalAlignment="Right" Margin="0,20,10,10" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                            <Border Width="400" Height="300" Background="#301E52" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,0,100" >
                                <Grid>
                                    <Image Source="/Imagenes/PieChart.jpg" />
                                </Grid>
                            </Border>
                            <Border Width="280" Height="300" Background="#301E52" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,310,100" >
                                <Grid>
                                    <Image Source="/Imagenes/BarChart.jpg" />
                                </Grid>
                            </Border>
                            <Border Width="700" Height="200" Background="#301E52" CornerRadius="10" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,0" >
                                <Image Source="/Imagenes/LineChart.jpg" Margin="7,0,9,0" />
                            </Border>
                            <Border Width="260" Height="488" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="10" Margin="720,160,0,0" Background="#241455" >
                                <Grid>
                                    <TextBlock Text="Últimos Movimientos" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" Margin="20,20,0,235" Width="183"  />
                                    <StackPanel Orientation="Horizontal" Margin="30,50,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/deposito.png" Width="30"/>
                                        <TextBlock Text="Deposito" Foreground="White" FontSize="10" Margin="20,0,0,0" />
                                        <TextBlock Text="1234" Foreground="White" FontSize="10" FontWeight="Bold" Margin="50,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,90,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/deposito.png" Width="30"/>
                                        <TextBlock Text="Deposito" Foreground="White" FontSize="10" Margin="20,0,0,0" />
                                        <TextBlock Text="1500" Foreground="White" FontSize="10" FontWeight="Bold" Margin="50,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,170,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/deposito.png" Width="30"/>
                                        <TextBlock Text="Deposito" Foreground="White" FontSize="10" Margin="20,0,0,0" />
                                        <TextBlock Text="1344" Foreground="White" FontSize="10" FontWeight="Bold" Margin="50,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,130,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/transferencia.png" Width="30"/>
                                        <TextBlock Text="TRANSFERENCIA" Foreground="White" FontSize="10"  Margin="20,10,0,0" />
                                        <TextBlock Text="-980" Foreground="Red" FontSize="10" FontWeight="Bold" Margin="20,10,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,210,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/transferencia.png" Width="30"/>
                                        <TextBlock Text="TRANSFERENCIA" Foreground="White" FontSize="10" Margin="20,0,0,0" />
                                        <TextBlock Text="-670" Foreground="Red" FontSize="10" FontWeight="Bold" Margin="20,10,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,250,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/transferencia.png" Width="30"/>
                                        <TextBlock Text="TRANSFERENCIA" Foreground="White" FontSize="10" Margin="20,0,0,0" />
                                        <TextBlock Text="-234" Foreground="Red" FontSize="10" FontWeight="Bold" Margin="20,10,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,290,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/deposito.png" Width="30"/>
                                        <TextBlock Text="Deposito" Foreground="White" FontSize="10" Margin="20,0,0,0" />
                                        <TextBlock Text="1560" Foreground="White" FontSize="10" FontWeight="Bold" Margin="50,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,330,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/deposito.png" Width="30"/>
                                        <TextBlock Text="Deposito" Foreground="White" FontSize="10" Margin="20,0,0,0" />
                                        <TextBlock Text="1342" Foreground="White" FontSize="10" FontWeight="Bold" Margin="50,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="30,370,0,0" VerticalAlignment="Top">
                                        <Image Source="/Iconos/transferencia.png" Width="30"/>
                                        <TextBlock Text="TRANSFERENCIA" Foreground="White" FontSize="10" Margin="20,10,0,0" />
                                        <TextBlock Text="-675" Foreground="Red" FontSize="10" FontWeight="Bold" Margin="20,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
