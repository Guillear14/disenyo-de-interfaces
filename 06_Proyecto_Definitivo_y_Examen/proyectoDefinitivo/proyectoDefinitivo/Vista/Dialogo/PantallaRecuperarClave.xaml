<mah:MetroWindow x:Class="proyectoDefinitivo.Vista.Dialogo.PantallaRecuperarClave"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyectoDefinitivo.Vista.Dialogo"
        mc:Ignorable="d"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="Recuperar Contraseña — DegradApp" Height="450" Width="800">
    <Grid>
        <!-- Fondo base adaptativo -->
        <Image Source="/Recursos/Imagenes/Onades de seda blava i daurada.png" Stretch="UniformToFill"/>

        <!-- Viewbox adaptativo 720p/1080p -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20">

            <!-- Panel Efecto Cristal centralizado -->
            <Border Style="{StaticResource GlassCardBorderStyle}"
                    Width="750" Height="580"
                    Padding="120,20,120,20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Logo -->
                        <RowDefinition Height="*"/>    <!-- Título -->
                        <RowDefinition Height="*"/>    <!-- Correo -->
                        <RowDefinition Height="*"/>    <!-- Descripción -->
                        <RowDefinition Height="*"/>    <!-- Botón -->
                        <RowDefinition Height="Auto"/> <!-- Volver / Pie -->
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Image Grid.Row="0" Source="/Recursos/Imagenes/LogoOscur-removebg-preview.png" 
                           Stretch="Uniform" HorizontalAlignment="Center" 
                           Height="135" Margin="0,0,0,0" />

                    <!-- Texto Superior -->
                    <TextBlock Grid.Row="1" Text="¿Olvidaste la clave? Tranquilo, duele menos que un mal degradado, te lo prometemos."
                           TextWrapping="WrapWithOverflow"
                           TextAlignment="Center"
                           FontSize="20"
                           Foreground="{StaticResource GoldAccentBrush}"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" />

                    <!-- Input: Correo Electrónico -->
                    <TextBox Grid.Row="2"
                             x:Name="txtCorreo"
                             Style="{StaticResource GlassOutlinedTextBoxStyle}"
                             Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch" 
                             VerticalAlignment="Center">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                <mat:PackIcon Kind="EmailOutline" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                                <TextBlock Text="Correo electrónico" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>

                    <!-- Texto Explicativo -->
                    <TextBlock Grid.Row="3" Text="Introduce la dirección de correo electrónico asociada a tu cuenta y te enviaremos un enlace seguro para restablecer tu contraseña."
                           TextWrapping="WrapWithOverflow"
                           TextAlignment="Center"
                           FontSize="15"
                           Foreground="{StaticResource GoldAccentBrush}" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <!-- Botón Recuperar Clave -->
                    <Button Grid.Row="4" Content="Recuperar Clave"
                            Style="{StaticResource PrimaryGradientButtonStyle}"
                            x:Name="BtnRecuperarClave"
                            Click="BtnRecuperarClave_Click"
                            Height="42"
                            Width="350"
                            Margin="20,0,20,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    <!-- Enlace Volver al Login y Pie -->
                    <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="← Volver a Iniciar Sesión"
                                   MouseLeftButtonDown="BtnVolverLogin_Click"
                                   Cursor="Hand"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{StaticResource PrimaryCopperGradientBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource GoldAccentBrush}" 
                                   Text="© 2026 - DegradApp" />
                    </StackPanel>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</mah:MetroWindow>
