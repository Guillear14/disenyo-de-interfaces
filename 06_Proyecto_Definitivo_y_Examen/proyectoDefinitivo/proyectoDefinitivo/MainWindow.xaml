<!-- =========================================================================
     PROYECTO DEFINITIVO - VENTANA PRINCIPAL (MENÚ + CERRAR SESIÓN + MVVM)
     ========================================================================= -->
<Window x:Class="proyectoDefinitivo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyectoDefinitivo"
        mc:Ignorable="d"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        ShowInTaskbar="True"
        WindowState="Maximized"
        Title="Pantalla Principal" Height="450" Width="800">
    <Grid>
        <!-- Imagen de fondo adaptada al tamaño de la ventana -->
        <Image Source="/Recursos/Imagenes/LocoClaro.jpg"
               Stretch="Fill"/>

        <!-- Menú superior enlazado a MainViewModel con opción para cerrar sesión -->
        <Menu HorizontalAlignment="Left" Height="Auto"
              VerticalAlignment="Top" Width="550" IsMainMenu="True">
            <MenuItem Header="DegradApp"/>
            <MenuItem Header="{Binding CorreoUsuarioActual}">
                <MenuItem Header="Cerrar Sesión" x:Name="BtnCerrarSesion" Click="BtnCerrarSesion_Click" />
            </MenuItem>
        </Menu>
    </Grid>
</Window>
