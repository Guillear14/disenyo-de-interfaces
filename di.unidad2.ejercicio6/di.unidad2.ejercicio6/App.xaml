<!-- ARCHIVO: App.xaml                                                          -->
<!-- FUNCION: Punto de entrada de recursos globales de la aplicacion WPF.      -->
<!--          Define la ventana inicial (StartupUri) y diccionarios de estilos.-->
<!-- ========================================================================== -->
<Application x:Class="di.unidad2.ejercicio6.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- Sintaxis moderna para versiones 4.0+ de MaterialDesign -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />

                <!-- Estilos por defecto de los controles (esto es lo que dibuja el CheckBox) -->
                

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>