<!-- =========================================================================
     PROYECTO DEFINITIVO - PANTALLA DE LOGIN (MAHAPPS + MATERIAL DESIGN + MVVM)
     ========================================================================= -->
<mah:MetroWindow x:Class="proyectoDefinitivo.Vista.Dialogo.PantallaLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyectoDefinitivo.Vista.Dialogo"
        xmlns:helpers="clr-namespace:proyectoDefinitivo.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Iniciar Sesión — DegradApp" Height="450" Width="800"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- 1. FONDO BASE ADAPTATIVO -->
        <Image Source="/Recursos/Imagenes/Onades de seda blava i daurada.png" Stretch="UniformToFill"/>

        <!-- 2. VIEWBOX: Escala proporcionalmente el panel central en pantallas 720p/1080p -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20">

            <!-- 3. PANEL EFECTO CRISTAL CENTRALIZADO EN Recursos/Estilos/EstilosGlobales.xaml -->
            <Border Style="{StaticResource GlassCardBorderStyle}"
                    Width="750" Height="580"
                    Padding="60,40,60,10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Fila 0: Logo -->
                        <RowDefinition Height="Auto"/> <!-- Fila 1: Email -->
                        <RowDefinition Height="Auto"/> <!-- Fila 2: Password -->
                        <RowDefinition Height="Auto"/> <!-- Fila 3: CheckBox Recordarme -->
                        <RowDefinition Height="Auto"/> <!-- Fila 4: Botón Iniciar Sesión -->
                        <RowDefinition Height="*"/>    <!-- Fila 5: Enlaces inferiores -->
                    </Grid.RowDefinitions>

                    <!-- FILA 0: Logotipo superior -->
                    <Image Grid.Row="0" Source="/Recursos/Imagenes/LogoOscur.jpg" 
                           Stretch="Uniform" HorizontalAlignment="Center" 
                           Height="100" Margin="0,0,0,30" />

                    <!-- FILA 1: CAMPO CORREO ELECTRÓNICO (ESTILO CENTRALIZADO + BINDING MVVM) -->
                    <TextBox Grid.Row="1" 
                             x:Name="txtcorreo"
                             Style="{StaticResource GlassOutlinedTextBoxStyle}"
                             Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                             Margin="60,15,60,15"
                             FontSize="18"
                             Padding="8">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                <materialDesign:PackIcon Kind="User" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                                <TextBlock Text="Correo electrónico" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>

                    <!-- FILA 2: CAMPO CONTRASEÑA (ESTILO CENTRALIZADO + ATTACHED PROPERTY MVVM) -->
                    <PasswordBox Grid.Row="2" 
                                 x:Name="passClaveAcceso"
                                 Style="{StaticResource GlassOutlinedPasswordBoxStyle}"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="60,15,60,30"
                                 FontSize="18"
                                 Padding="8">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                <materialDesign:PackIcon Kind="LockOutline" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                                <TextBlock Text="Contraseña" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </PasswordBox>

                    <!-- FILA 3: CHECKBOX "¿RECORDARME?" -->
                    <CheckBox Grid.Row="3"
                              IsChecked="{Binding Recordarme}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              FocusVisualStyle="{x:Null}"
                              Margin="0,0,0,25"
                              BorderBrush="{StaticResource GoldAccentBrush}">
                        <TextBlock Text="¿Recordarme?" Foreground="{StaticResource GoldAccentBrush}"/>
                    </CheckBox>

                    <!-- FILA 4: BOTÓN INICIAR SESIÓN CON ESTILO CENTRALIZADO -->
                    <Button Grid.Row="4" Content="Iniciar Sesión" 
                            Style="{StaticResource PrimaryGradientButtonStyle}"
                            Margin="80,0,80,0"
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Center"
                            x:Name="btnLogin"
                            Click="btnLogin_Click"/>

                    <!-- FILA 5: ENLACES INFERIORES -->
                    <StackPanel Orientation="Horizontal" Grid.Row="5" HorizontalAlignment="Center">
                        <TextBlock Text="¿Olvidaste tu contraseña?"
                                   x:Name="btnOlvidarContraseña"
                                   MouseLeftButtonDown="btnOlvidarContraseña_Click"
                                   Cursor="Hand"
                                   Margin="0,0,20,15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Foreground="{StaticResource PrimaryCopperGradientBrush}"/>

                        <TextBlock Text="Regístrate"
                                   x:Name="Registrobtn"
                                   MouseLeftButtonDown="Registrobtn_Click"
                                   Cursor="Hand"
                                   Margin="0,0,0,15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Foreground="{StaticResource PrimaryCopperGradientBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</mah:MetroWindow>
