<mah:MetroWindow x:Class="PlantillaExamen.Vista.Dialogo.VentanaSecundaria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Nuevo Registro / Detalle"
        Height="340" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Alta Rápida en Ventana Modal"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryColor}"
                   Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <TextBox x:Name="txtModalNombre"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     mat:HintAssist.Hint="Nombre del elemento"
                     Margin="0,0,0,12"/>

            <ComboBox x:Name="cmbModalCategoria"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      mat:HintAssist.Hint="Categoría"
                      SelectedIndex="0"
                      Margin="0,0,0,12">
                <ComboBoxItem Content="General"/>
                <ComboBoxItem Content="Prioritario"/>
                <ComboBoxItem Content="Soporte"/>
            </ComboBox>

            <mah:NumericUpDown x:Name="numModalImporte"
                               Minimum="0" Maximum="10000" Interval="10"
                               Value="100" StringFormat="C2"
                               mat:HintAssist.Hint="Importe (€)"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Click="BtnCancelar_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,10,0"/>
            <Button Content="Guardar" Click="BtnAceptar_Click"
                    Background="{StaticResource AccentColor}"
                    BorderBrush="{StaticResource AccentColor}"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
