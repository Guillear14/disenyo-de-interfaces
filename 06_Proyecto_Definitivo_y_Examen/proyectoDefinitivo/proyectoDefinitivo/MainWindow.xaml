<!-- =========================================================================
     PROYECTO DEFINITIVO - DASHBOARD PRINCIPAL (MAHAPPS + MATERIAL DESIGN + MVVM)
     ========================================================================= -->
<mah:MetroWindow x:Class="proyectoDefinitivo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyectoDefinitivo"
        mc:Ignorable="d"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        ShowInTaskbar="True"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="Panel Principal — DegradApp" Height="720" Width="1280">
    <Grid>
        <!-- 1. Imagen de fondo corporativa -->
        <Image Source="/Recursos/Imagenes/LocoClaro.jpg" Stretch="UniformToFill"/>

        <!-- 2. Menú superior con usuario activo y cierre de sesión -->
        <Menu HorizontalAlignment="Stretch" VerticalAlignment="Top"
              Background="#CC101826" Foreground="{StaticResource GoldAccentBrush}"
              Padding="16,4" IsMainMenu="True">
            <MenuItem Header="DegradApp" FontWeight="Bold" Foreground="White"/>
            <MenuItem Header="{Binding CorreoUsuarioActual}" Foreground="{StaticResource GoldAccentBrush}">
                <MenuItem Header="Cerrar Sesión" x:Name="BtnCerrarSesion"
                          Command="{Binding CerrarSesionCommand}"
                          Click="BtnCerrarSesion_Click"/>
            </MenuItem>
        </Menu>

        <!-- 3. Contenedor adaptable 720p/1080p con estética Glassmorphism centralizada -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="30,60,30,30">
            <Border Style="{StaticResource GlassCardBorderStyle}" Width="1050" Height="580" Padding="40,30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera del Dashboard -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="PANEL DE CONTROL — DEGRADAPP" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding CorreoUsuarioActual, StringFormat='Sesión activa: {0}'}"
                                       FontSize="14" Foreground="{StaticResource GoldAccentBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Content="Cerrar Sesión"
                                Style="{StaticResource PrimaryGradientButtonStyle}"
                                Width="200" Height="40" FontSize="15"
                                HorizontalAlignment="Right"
                                Click="BtnCerrarSesion_Click"/>
                    </DockPanel>

                    <!-- 3 Tarjetas KPI -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,24">
                        <Border Background="#66000000" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="USUARIOS REGISTRADOS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}"/>
                                <TextBlock Text="{Binding TotalUsuarios}" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#66000000" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="USUARIO EN SESIÓN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}"/>
                                <TextBlock Text="{Binding CorreoUsuarioActual}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#66000000" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="INICIO DE SESIÓN" FontSize="12" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}"/>
                                <TextBlock Text="{Binding FechaSesionActual}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Tabla de Usuarios Persistidos en el Repositorio -->
                    <Border Grid.Row="2" Background="#66000000" BorderBrush="{StaticResource GoldAccentBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Directorio de Usuarios Registrados (Persistencia JSON)"
                                       FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}" Margin="0,0,0,12"/>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding UsuariosRegistrados}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      Background="Transparent"
                                      RowBackground="#33101826"
                                      Foreground="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Correo Electrónico" Binding="{Binding Correo}" Width="*"/>
                                    <DataGridTextColumn Header="Fecha de Alta" Binding="{Binding FechaRegistro, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</mah:MetroWindow>
