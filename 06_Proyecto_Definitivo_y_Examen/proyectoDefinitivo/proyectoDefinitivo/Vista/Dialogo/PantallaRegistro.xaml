<mah:MetroWindow x:Class="proyectoDefinitivo.Vista.Dialogo.PantallaRegistro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyectoDefinitivo.Vista.Dialogo"
        xmlns:helpers="clr-namespace:proyectoDefinitivo.Helpers"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Title="Registro de Usuario — DegradApp" Height="450" Width="800">

    <Grid>
        <!-- Fondo base adaptativo -->
        <Image Source="/Recursos/Imagenes/Onades de seda blava i daurada.png" Stretch="UniformToFill"/>

        <!-- Viewbox adaptativo para pantallas 720p/1080p -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20">

            <!-- Panel Efecto Cristal centralizado -->
            <Border Style="{StaticResource GlassCardBorderStyle}"
                    Width="750" Height="580"
                    Padding="60,40,60,25">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Logo -->
                        <RowDefinition Height="Auto"/> <!-- Correo -->
                        <RowDefinition Height="Auto"/> <!-- Contraseña -->
                        <RowDefinition Height="Auto"/> <!-- Confirmación -->
                        <RowDefinition Height="*"/>    <!-- Botón -->
                        <RowDefinition Height="Auto"/> <!-- Volver al Login -->
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Image Grid.Row="0" Source="/Recursos/Imagenes/LogoOscur-removebg-preview.png"
                           Stretch="Uniform" HorizontalAlignment="Center" 
                           Height="130" Margin="0,0,0,25" />

                    <!-- Input: Correo Electrónico -->
                    <TextBox Grid.Row="1" Margin="0,0,0,22"
                             x:Name="txtCorreo"
                             Style="{StaticResource GlassOutlinedTextBoxStyle}"
                             Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                <materialDesign:PackIcon Kind="EmailOutline" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                                <TextBlock Text="Correo electrónico" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </TextBox>

                    <!-- Input: Contraseña -->
                    <PasswordBox Grid.Row="2" Margin="0,0,0,20"
                                 x:Name="passClaveAcceso"
                                 Style="{StaticResource GlassOutlinedPasswordBoxStyle}"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                <materialDesign:PackIcon Kind="LockOutline" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                                <TextBlock Text="Contraseña" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </PasswordBox>

                    <!-- Input: Repetir Contraseña -->
                    <PasswordBox Grid.Row="3" Margin="0,0,0,20"
                                 x:Name="passClaveAccesoRepetir"
                                 Style="{StaticResource GlassOutlinedPasswordBoxStyle}"
                                 helpers:PasswordBoxHelper.BindPassword="True"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmarPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                <materialDesign:PackIcon Kind="RepeatVariant" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                                <TextBlock Text="Repetir Contraseña" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </PasswordBox>

                    <!-- Botón Registrarse -->
                    <Button Grid.Row="4" Content="Registrarse" 
                            Style="{StaticResource PrimaryGradientButtonStyle}"
                            x:Name="BtnRegistrarse"
                            Click="BtnRegistrarse_Click"
                            Margin="80,0,80,0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                    <!-- Enlace Volver al Login -->
                    <TextBlock Grid.Row="5"
                               Text="¿Ya tienes cuenta? Volver a Iniciar Sesión"
                               MouseLeftButtonDown="BtnVolverLogin_Click"
                               Cursor="Hand"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource GoldAccentBrush}"
                               Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</mah:MetroWindow>
