<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Empaquetado automático de imágenes, iconos y fuentes en Recursos/ (excluyendo diccionarios .xaml) -->
  <ItemGroup>
    <None Remove="Recursos\**\*.png" />
    <None Remove="Recursos\**\*.jpg" />
    <None Remove="Recursos\**\*.ttf" />
    <Resource Include="Recursos\**\*.png" />
    <Resource Include="Recursos\**\*.jpg" />
    <Resource Include="Recursos\**\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Datos\Repositorios\" />
    <Folder Include="Helpers\" />
    <Folder Include="Modelos\" />
    <Folder Include="Recursos\Estilos\" />
    <Folder Include="Recursos\Iconos\" />
    <Folder Include="Servicios\Interfaces\" />
    <Folder Include="ViewModel\" />
    <Folder Include="Vista\UserControl\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="5.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
