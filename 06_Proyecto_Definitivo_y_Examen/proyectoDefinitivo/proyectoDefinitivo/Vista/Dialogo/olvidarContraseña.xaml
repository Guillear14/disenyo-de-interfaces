<mah:MetroWindow x:Class="proyectoDefinitivo.Vista.Dialogo.olvidarContraseña"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyectoDefinitivo.Vista.Dialogo"
        mc:Ignorable="d"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowState="Maximized"
        Title="olvidarContraseña" Height="450" Width="800">
    <Grid>
        <!-- Fondo base adaptativo -->
        <Image Source="/Recursos/Imagenes/Onades de seda blava i daurada.png" Stretch="UniformToFill"/>

        <!-- EL VIEWBOX: StretchDirection="DownOnly" evita que se vuelva gigante en 1080p -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20">

            <!-- PANEL EFECTO CRISTAL -->
            <!-- Medidas ajustadas a las proporciones exactas de tu captura en 720p -->
            <Border Width="750" Height="580" 
                    BorderBrush="#C79F86" 
                    BorderThickness="2" 
                    CornerRadius="25" 
                    Background="#B3101826"
                    Padding="120,20,120,20">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Color="Black" Opacity="0.5" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Logo -->
                        <RowDefinition Height="*"/>
                        <!-- Titulo -->
                        <RowDefinition Height="*"/>
                        <!-- Password -->
                        <RowDefinition Height="*"/>
                        <!-- Descripcion -->
                        <RowDefinition Height="*"/>
                        <!-- Botón -->
                        <RowDefinition Height="Auto"/>
                        <!-- Texto final -->
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Image Grid.Row="0" Source="/Recursos/Imagenes/LogoOscur-removebg-preview.png" 
                           Stretch="Uniform" HorizontalAlignment="Center" 
                           Height="140" Margin="0,0,0,0" />

                    <!-- Texto Olvidar Contraseña Inicial-->
                    <TextBlock Grid.Row="1" Text="¿Olvidaste la clave? Tranquilo, duele menos que un mal degradado, te lo prometemos."
                           TextWrapping="WrapWithOverflow"
                           TextAlignment="Center"
                           FontSize="20"
                           Foreground="#C79F86" Cursor="Hand" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" />

                    <!-- Input: Correo Electrónico -->
                    <TextBox Grid.Row="2"
                             x:Name="txtcorreo"
                             HorizontalAlignment="Stretch" 
                             VerticalAlignment="Center"
                             CaretBrush="White"
                             materialDesign:HintAssist.Foreground="#99C79F86"
                             materialDesign:HintAssist.Background="Transparent"
                             materialDesign:TextFieldAssist.UnderlineBrush="#000C38"
                             materialDesign:TextFieldAssist.HasClearButton="False"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="15">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                <Setter Property="Background" Value="#40000000" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#C79F86" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="#80000000" />
                                        <Setter Property="BorderBrush" Value="#000C38" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>

                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal" Margin="-2,0,0,0">
                                <mat:PackIcon Kind="User" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#C79F86" />
                                <TextBlock Text="Correo electrónico" VerticalAlignment="Center" Foreground="#C79F86" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>

                        <TextBox.Resources>
                            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#000C38"/>
                            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Mid" Color="#000C38"/>
                            <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Main" Color="#000C38"/>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Texto Olvidar Contraseña Inicial-->
                    <TextBlock Grid.Row="3" Text="Introduce la dirección de correo electrónico asociada a tu cuenta y 
                               te enviaremos un enlace seguro para restablecer tu contraseña."
                           TextWrapping="WrapWithOverflow"
                           TextAlignment="Center"
                           FontSize="15"
                           Foreground="#C79F86" 
                           HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Botón Recuperar Sesión -->
                    <Button Grid.Row="4" Content="Recuperar Clave"
                                x:Name="RecuperarClaveBtn"
                                Click="RecuperarClaveBtn_Click"
                                FontSize="20" 
                                Height="40"
                                Width="350"
                                Margin="20,0,20,20"
                                mat:ButtonAssist.CornerRadius="35" 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#101826" FontWeight="Bold">

                        <Button.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5D50" Offset="0.0"/>
                                <GradientStop Color="#E7B8A0" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.BorderBrush>
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5D50" Offset="0.0"/>
                                <GradientStop Color="#E7B8A0" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Texto Olvidar Contraseña Inicial-->
                    <TextBlock Grid.Row="5" 
                           VerticalAlignment="Bottom" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           FontSize="15"
                           Foreground="#C79F86" 
                           Text="© 2026 - DegradApp" />

                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</mah:MetroWindow>
