<!-- ========================================================================== -->
<!-- PROYECTO: di.unidad2.ejercicio10                                           -->
<!-- EJERCICIO: Unidad 2 - Ejercicio 10 (Login con Fondo Degradado y Redes)     -->
<!-- CARACTERISTICAS:                                                           -->
<!--   - Ventana sin marco OS (WindowStyle="None", ResizeMode="NoResize").      -->
<!--   - Tirador superior centrado idéntico al PDF.                             -->
<!--   - Fondo con LinearGradientBrush de #b22d2f (rojo) a #1b63b8 (azul).      -->
<!--   - Tarjeta central oscura compacta (#1A1D20) que empieza debajo del degradado. -->
<!--   - Campos Username y Contraseña en píldoras con borde azul (#254B62).     -->
<!--   - Enlace "¿Has olvidado la contraseña?".                                 -->
<!--   - Botón Login redondeado con borde verde (#2D604E).                      -->
<!--   - Iconos sociales blancos en la parte inferior (Facebook, Twitter, G+).  -->
<!-- ========================================================================== -->

<Window x:Class="di.unidad2.ejercicio10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:di.unidad2.ejercicio10"
        xmlns:mat="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="IES Henri Matisse - Login"
        Height="500" Width="780"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        MouseDown="Window_MouseDown">

    <!-- Fondo de la pantalla con degradado lineal horizontal especificado en el enunciado -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#b22d2f" Offset="0.0"/>
                <GradientStop Color="#1b63b8" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Tirador superior decorativo idéntico al PDF -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" 
                Width="42" Height="14" 
                Background="#E5E5E5" BorderBrush="#AAAAAA" BorderThickness="1,0,1,1" 
                CornerRadius="0,0,2,2" Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Rectangle Width="24" Height="2" Fill="#888888" Margin="0,0,0,2"/>
                <Rectangle Width="24" Height="2" Fill="#888888"/>
            </StackPanel>
        </Border>

        <!-- Tarjeta central oscura compacta con margen superior visible de degradado -->
        <Border Width="460"
                Background="#1A1D20"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Margin="0,44,0,0">
            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- Título principal con espaciado amplio -->
                <TextBlock Text="L O G I N"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <!-- Subtítulo explicativo -->
                <TextBlock Text="Por favor introduce tu usuario y clave"
                           FontSize="12"
                           Foreground="#9DA7B2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <!-- Campo píldora: Username -->
                <Border Width="300"
                        Height="42"
                        CornerRadius="21"
                        BorderThickness="1.2"
                        BorderBrush="#254B62"
                        Background="#1A1D20"
                        Margin="0,0,0,14"
                        Padding="14,0,14,0">
                    <TextBox mat:HintAssist.Hint="Username"
                             mat:HintAssist.Foreground="#5A6C7D"
                             mat:TextFieldAssist.UnderlineBrush="Transparent"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#B0BEC5"
                             FontSize="12.5"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="0" />
                </Border>

                <!-- Campo píldora: Contraseña -->
                <Border Width="300"
                        Height="42"
                        CornerRadius="21"
                        BorderThickness="1.2"
                        BorderBrush="#254B62"
                        Background="#1A1D20"
                        Margin="0,0,0,18"
                        Padding="14,0,14,0">
                    <PasswordBox mat:HintAssist.Hint="Contraseña"
                                 mat:HintAssist.Foreground="#5A6C7D"
                                 mat:TextFieldAssist.UnderlineBrush="Transparent"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#B0BEC5"
                                 FontSize="12.5"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Padding="0" />
                </Border>

                <!-- Enlace: ¿Has olvidado la contraseña? -->
                <TextBlock Text="¿Has olvidado la contraseña?"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Cursor="Hand"
                           Margin="0,0,0,22" />

                <!-- Botón Login píldora con borde verde -->
                <Button Content="Login"
                        Width="135"
                        Height="38"
                        FontSize="12.5"
                        Foreground="#8C98A0"
                        Background="Transparent"
                        BorderBrush="#2D604E"
                        BorderThickness="1.2"
                        mat:ButtonAssist.CornerRadius="19"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Margin="0,0,0,26" />

                <!-- Iconos de redes sociales en blanco -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                    <!-- Facebook -->
                    <Image Source="Recursos/iconos/facebookblanco.png"
                           Width="20" Height="20"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Cursor="Hand"
                           Margin="14,0" />

                    <!-- Twitter -->
                    <Image Source="Recursos/iconos/twitter.png"
                           Width="20" Height="20"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Cursor="Hand"
                           Margin="14,0" />

                    <!-- Google+ -->
                    <Image Source="Recursos/iconos/googleplus.png"
                           Width="24" Height="24"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Cursor="Hand"
                           Margin="14,0" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
